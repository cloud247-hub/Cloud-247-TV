<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="34dp"
        android:paddingRight="34dp"
        android:background="@color/navy">

        <ImageView
            android:id="@+id/cloudLogo"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:contentDescription="Cloud247"
            android:src="@drawable/cloud247_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOUD247 TV"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIN TV · DIN SPILLELISTE"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.5.1"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/sourcePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:paddingRight="42dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIN SPILLELISTE · DIN TV"
                    android:textColor="@color/yellow"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="TV uten\nunødvendig støy."
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="0.92" />

                <TextView
                    android:layout_width="560dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Legg inn M3U-adressen direkte på Android TV. Avspillingen går fra TV-en til IPTV-leverandøren – uten nettleser-CORS og uten Cloudflare som mellomledd."
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="● Direkte avspilling   •   HLS / MPEG-TS   •   XMLTV / EPG"
                    android:textColor="@color/success"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="520dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/panel_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KOM I GANG"
                    android:textColor="@color/yellow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Koble til Cloud247 TV"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/pairingQr"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:background="#FFFFFF"
                        android:padding="7dp"
                        android:contentDescription="QR-kode for kobling til Cloud247 TV" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SKANN MED MOBILEN"
                            android:textColor="@color/muted"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/pairingCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="------"
                            android:textColor="@color/yellow"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/pairingStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Lager sikker TV-kode …"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:maxLines="2" />

                        <Button
                            android:id="@+id/newPairingButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/focus_button"
                            android:text="Lag ny QR-kode"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/playlistUrl"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_bg"
                        android:hint="M3U-adresse"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:textColor="@color/white"
                        android:textColorHint="@color/muted"
                        android:textSize="15sp"
                        android:selectAllOnFocus="true" />

                    <Button
                        android:id="@+id/loadPlaylistButton"
                        android:layout_width="128dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/focus_button"
                        android:text="Åpne →"
                        android:textColor="@color/button_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/pickPlaylistButton"
                        android:layout_width="104dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/focus_button"
                        android:text="M3U-fil"
                        android:textColor="@color/button_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/sourceProgress"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:indeterminateTint="@color/yellow"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/sourceStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="QR er enklest. M3U-adressen lagres kryptert lokalt på TV-en etter vellykket tilkobling."
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="6dp"
                android:paddingRight="6dp">

                <TextView
                    android:id="@+id/playlistTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direkte-TV"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playlistStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:text="0 kanaler"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="OK: se kanal   •   Hold OK: favoritt"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/sportsButton"
                    android:layout_width="150dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/focus_button"
                    android:text="Sport"
                    android:textColor="@color/button_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/epgButton"
                    android:layout_width="120dp"
                    android:layout_height="46dp"
                    android:background="@drawable/focus_button"
                    android:text="TV-guide"
                    android:textColor="@color/button_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/changePlaylistButton"
                    android:layout_width="150dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/focus_button"
                    android:text="Bytt liste"
                    android:textColor="@color/button_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="320dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/panel_bg"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRUPPER"
                        android:textColor="@color/yellow"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:padding="8dp" />

                    <ListView
                        android:id="@+id/groupList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="5dp"
                        android:listSelector="@drawable/focus_list_item"
                        android:choiceMode="singleChoice"
                        android:focusable="true"
                        android:nextFocusRight="@id/channelList" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/panel_bg"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/channelHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ALLE KANALER"
                        android:textColor="@color/yellow"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:padding="8dp" />

                    <EditText
                        android:id="@+id/channelSearch"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="10dp"
                        android:nextFocusDown="@id/channelList"
                        android:background="@drawable/input_bg"
                        android:hint="Søk kanaler…"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="@color/muted"
                        android:textSize="16sp" />

                    <ListView
                        android:id="@+id/channelList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="5dp"
                        android:listSelector="@drawable/focus_list_item"
                        android:focusable="true"
                        android:nextFocusLeft="@id/groupList" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
