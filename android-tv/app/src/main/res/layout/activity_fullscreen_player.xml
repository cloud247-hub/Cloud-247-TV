<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreenPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/castRemoteRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@color/navy"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#071827">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CAST REMOTE"
                    android:textColor="@color/yellow"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <androidx.mediarouter.app.MediaRouteButton
                    android:id="@+id/castRemoteRouteButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="Bytt Cast-enhet" />
            </LinearLayout>

            <TextView
                android:id="@+id/castRemoteDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📺 Chromecast"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/castRemoteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Cloud247 TV"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/castRemoteProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/castRemoteNextProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castRemotePrevious"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/focus_button"
                    android:text="‹ Forrige"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castRemotePlayPause"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:background="@drawable/focus_button"
                    android:text="Pause"
                    android:textColor="@color/yellow"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castRemoteNext"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:background="@drawable/focus_button"
                    android:text="Neste ›"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castRemoteSleep"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/focus_button"
                    android:text="Sleep · Av"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castRemoteStop"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:background="@drawable/focus_button"
                    android:text="Stopp casting"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="20dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp"
            android:background="#0A223A">

            <TextView
                android:id="@+id/castRemoteContentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REMOTE"
                android:textColor="@color/yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/castRemoteContentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Nettbrettet fungerer nå som kontrollpanel."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <ListView
                android:id="@+id/castRemoteContentList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="5dp"
                android:listSelector="@drawable/focus_list_item" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/fullscreen_overlay_bg">

                <TextView
                    android:id="@+id/castTabRemote"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Remote"
                    android:textColor="@color/yellow"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castTabChannels"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Kanaler"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castTabGuide"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="TV-guide"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/castTabSport"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sport"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/fullscreenNightFilter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF201008"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fullscreenOverlay"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:background="@drawable/fullscreen_overlay_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:src="@drawable/cloud247_mark"
                android:contentDescription="Cloud247"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/fullscreenClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="20:00"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/fullscreenCastButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Cast til TV"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/fullscreenName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fullscreenNextProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fullscreenHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="↑/↓ bytter kanal · → kanalvelger · Swipe og touch støttes"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenChannelPanel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#F0061A2F"
        android:visibility="gone">

        <TextView
            android:id="@+id/fullscreenChannelPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KANALER"
            android:textColor="@color/yellow"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Velg kanal uten å forlate fullskjerm"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <ListView
            android:id="@+id/fullscreenChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:listSelector="@drawable/focus_list_item"
            android:choiceMode="singleChoice"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenNightPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FA020A12"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NATTMODUS"
            android:textColor="@color/yellow"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/fullscreenNightStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Roligere bilde og lyd for kvelden."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/fullscreenNightToggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:text="Nattmodus: Av"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenSleepTimer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:text="Sleep timer: Av"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenNightFilterButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:text="Nattfilter: Normal"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenNightVolume"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:text="Nattlyd: 45 %"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenNightBrightness"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:text="Lysstyrke: 30 %"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← åpner nattmenyen · → åpner kanaler"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenTouchControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/fullscreen_overlay_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fullscreenPrevious"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="145dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="‹  Forrige"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#553C5D78" />

        <TextView
            android:id="@+id/fullscreenNight"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="120dp"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Natt"
            android:textColor="@color/yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#553C5D78" />

        <TextView
            android:id="@+id/fullscreenChannels"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="130dp"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Kanaler"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#553C5D78" />

        <TextView
            android:id="@+id/fullscreenNext"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="145dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Neste  ›"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
