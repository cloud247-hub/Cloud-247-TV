<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreenPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/fullscreenOverlay"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:background="@drawable/fullscreen_overlay_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:src="@drawable/cloud247_mark"
                android:contentDescription="Cloud247"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/fullscreenClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="20:00"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/fullscreenName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fullscreenProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fullscreenNextProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fullscreenHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="↑/↓ bytter kanal · → kanalvelger · Swipe og touch støttes"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenChannelPanel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#F0061A2F"
        android:visibility="gone">

        <TextView
            android:id="@+id/fullscreenChannelPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KANALER"
            android:textColor="@color/yellow"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Velg kanal uten å forlate fullskjerm"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <ListView
            android:id="@+id/fullscreenChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:listSelector="@drawable/focus_list_item"
            android:choiceMode="singleChoice"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenTouchControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/fullscreen_overlay_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fullscreenPrevious"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="145dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="‹  Forrige"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#553C5D78" />

        <TextView
            android:id="@+id/fullscreenChannels"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="150dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Kanaler"
            android:textColor="@color/yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#553C5D78" />

        <TextView
            android:id="@+id/fullscreenNext"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="145dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Neste  ›"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
