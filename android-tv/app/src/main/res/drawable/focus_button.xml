<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yellow" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/yellow_deep" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yellow_deep" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/line" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
